# SPA routing para hospedagem Apache (Hostinger).
# Redireciona qualquer rota inexistente para o index.html, deixando o
# React Router cuidar das rotas (/pets, /sos, /biblioteca, etc.).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # não reescreve arquivos e pastas que existem de verdade
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # o resto cai no app
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # assets com hash no nome podem ser cacheados por muito tempo...
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # ...mas o HTML e o service worker NUNCA (garante atualização instantânea).
  # Este bloco vem depois, então vence para estes arquivos específicos.
  <FilesMatch "(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
