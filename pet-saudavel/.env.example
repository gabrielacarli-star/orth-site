# =========================================================================
# Pet Saudável — variáveis de ambiente do FRONTEND (Vite)
# -------------------------------------------------------------------------
# 1. Copie este arquivo para `.env` (na mesma pasta)
# 2. Preencha com os dados do SEU projeto Supabase
#    (Supabase → Project Settings → API)
# 3. NUNCA comite o arquivo `.env` — só a `anon key` é segura aqui,
#    e mesmo assim o `.env` fica de fora do Git.
# =========================================================================

# URL do projeto Supabase — ex.: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Chave pública "anon" (publishable). Pode ficar no frontend com segurança
# porque o Row Level Security do banco protege os dados.
VITE_SUPABASE_ANON_KEY=
