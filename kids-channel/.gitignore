# Dependências e saída de render do projeto Remotion
video/node_modules/
video/out/

# Áudio gerado pela ElevenLabs: é grande, custa centavos pra refazer e
# muda a cada geração. Fica local.
episodios/*/audio/
video/public/sfx/
# A música escolhida é copiada pra public/ pelo sincronizar_legenda.py.
# WAV desde a Fase 6 (master sem perda), mas a regra cobre os dois.
video/public/musica-*.wav
video/public/musica-*.mp3

# Backup automático do sincronizar_legenda.py
episodios/*/episodio.json.bak

# Cache de bytecode do Python, gerado ao importar scripts/comum.py
__pycache__/
*.pyc
