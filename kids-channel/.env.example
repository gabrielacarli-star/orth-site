# Copie este arquivo para ".env" (sem o ".example") e preencha.
# O ".env" de verdade NUNCA deve ser commitado — já está no .gitignore.

# Chave da ElevenLabs — elevenlabs.io -> Settings -> API Keys
ELEVENLABS_API_KEY=

# Vozes dos personagens (Voice Library, filtrando por Portuguese / Brazilian).
# Só serão usadas na Fase 5 (falas soltas fora da música). A música em si já
# vem cantada da Eleven Music, não precisa de voz separada.
#
# Pipo  — aguda, rápida, empolgada (evite vozes marcadas "calm"/"narration")
# Nina  — média, morna, ritmo mais devagar
# Jaci  — grave, muito devagar, quase sussurrada (pilar Noite)
VOZ_PIPO=
VOZ_NINA=
VOZ_JACI=
