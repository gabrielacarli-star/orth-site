# Copie este arquivo para ".env" (sem o ".example") e preencha com os
# valores reais. O ".env" de verdade NUNCA deve ser commitado — ele já
# está no .gitignore da raiz do projeto.

# Chave de API da ElevenLabs (Settings -> API Keys, depois de logada)
ELEVENLABS_API_KEY=

# ID da voz escolhida na Voice Library (idioma Portuguese, sotaque Brazilian)
ELEVENLABS_VOICE_ID=

# Chave de API do fal.ai (fal.ai/dashboard/keys), usada na Fase 4 pra
# gerar imagens com Flux Pro. Formato: "id:secret"
FAL_KEY=
